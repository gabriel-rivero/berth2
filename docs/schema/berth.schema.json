  "event": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "`{\"event\":\"agent.state_changed\",\"seq\":42,\"ts\":\"…\",\"data\":{…}}`",
    "properties": {
      "data": {
        "default": null
